# Root .gitignore for Nova Project

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment / Secret Files
.env
.env.local
.env.*.local

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
*.db
*.sqlite
*.sqlite3
backend/nova.db
backend/app/ml/models/*.joblib
backend/app/ml/models/*.png

# Node / React / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / Editor Files
.vscode/
.idea/
*.swp
*.swo
