# Root .gitignore for Nova Project

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment / Secret Files
.env
.env.local
.env.*.local

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
*.db
*.sqlite
*.sqlite3
backend/nova.db
# NOTE: backend/app/ml/models/*.joblib is intentionally tracked, not
# ignored, despite being a "regenerable" build artifact -- a hackathon
# judge cloning this repo needs the trained classifier/scorer to actually
# work without separately running the full ml_pipeline/ training
# procedure first. Only exclude the plot images, which are cosmetic.
backend/app/ml/models/*.png

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ML Pipeline — regenerable synthetic data & trained model artifacts
# (metadata *.json files are kept tracked — small, human-readable, and
# useful for the audit trail; only the large/binary outputs are ignored)
ml_pipeline/data/
ml_pipeline/artifacts/*.joblib
ml_pipeline/artifacts/*.png
*.pkl

# Node / React / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / Editor Files
.vscode/
.idea/
*.swp
*.swo
